{
  "name": "onestep",
  "version": "1.2.3",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:android": "playwright test tests/mobile-ui.spec.ts --project=android",
    "test:ios": "playwright test tests/mobile-ui.spec.ts --project=ios",
    "dev:mobile": "next dev --hostname 0.0.0.0",
    "native:add:android": "cross-env CAPACITOR_SERVER_URL=http://10.0.2.2:3000 cap add android",
    "native:add:ios": "cross-env CAPACITOR_SERVER_URL=http://localhost:3000 cap add ios",
    "native:android": "cross-env CAPACITOR_SERVER_URL=http://10.0.2.2:3000 cap run android",
    "native:ios": "cross-env CAPACITOR_SERVER_URL=http://localhost:3000 cap run ios"
  },
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "@vercel/analytics": "^1.1.4",
