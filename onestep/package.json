    "@capacitor/ios": "^8.6.0",
    "firebase": "^12.10.0",
    "firebase-admin": "^14.2.0",
    "lucide-react": "^1.33.0",
    "next": "^16.2.12",
    "postcss": "^8.5.15",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-email": "^6.9.1",
    "resend": "^6.18.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
